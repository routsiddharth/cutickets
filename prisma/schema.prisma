// Campus Ticket Board — data model
// Postgres in every environment (local + Vercel). Note: status/type fields are
// Strings validated in application code (see src/lib/constants.ts) rather than
// native enums, to keep migrations cheap.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Env vars auto-injected by the Vercel Postgres/Neon integration:
  url       = env("POSTGRES_PRISMA_URL") //      pooled (pgbouncer) — runtime
  directUrl = env("POSTGRES_URL_NON_POOLING") // direct — used for migrations
}

// ─── Auth.js (NextAuth) models ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // Campus Ticket Board profile fields (collected at onboarding)
  school    String? // e.g. "Columbia College", "Barnard College", "SEAS", "GS"
  classYear Int? //    graduation year, e.g. 2027
  bannedAt  DateTime? // set when an admin/automated control bans the account
  role      String    @default("USER") // "USER" | "ADMIN"

  // Phone verification (Firebase phone OTP, gated before profile setup)
  phone           String? //   E.164, e.g. "+15551234567"
  phoneVerifiedAt DateTime? // set once the OTP is confirmed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  listings         Listing[]      @relation("ListingSeller")
  dealsAsBuyer     Deal[]         @relation("DealBuyer")
  dealsAsSeller    Deal[]         @relation("DealSeller")
  reportsMade      Report[]       @relation("Reporter")
  reportsReceived  Report[]       @relation("Reported")
  ratingsGiven     Rating[]       @relation("RatingAuthor")
  ratingsReceived  Rating[]       @relation("RatingSubject")
  eventsCreated    Event[]        @relation("EventCreator")
  eventRequests    EventRequest[] @relation("EventRequester")
  requestsResolved EventRequest[] @relation("EventRequestResolver")
  messagesSent     Message[]      @relation("MessageSender")
  notifications    Notification[] @relation("UserNotifications")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Marketplace models ────────────────────────────────────────────────────

model Event {
  id          String    @id @default(cuid())
  name        String
  venue       String?
  startsAt    DateTime?
  description String?
  poshLink    String? // optional link to the event's Posh page
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  createdBy     User           @relation("EventCreator", fields: [createdById], references: [id])
  listings      Listing[]
  deals         Deal[]
  requests      EventRequest[]
  notifications Notification[]

  @@index([startsAt])
  @@index([archivedAt, startsAt])
}

// A student suggestion for an event that is missing from the market. Admins
// can create an event from the request or dismiss it without exposing an event
// creation surface to regular users.
model EventRequest {
  id           String    @id @default(cuid())
  requesterId  String
  name         String
  venue        String?
  startsAt     DateTime?
  details      String?
  status       String    @default("PENDING") // PENDING | FULFILLED | DISMISSED
  eventId      String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  requester  User   @relation("EventRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  resolvedBy User?  @relation("EventRequestResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  event      Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([requesterId, status])
}

// A fixed-price ticket listing posted by a seller. Buyers reserve some or all
// of the available quantity, which creates a Deal and opens the private chat.
model Listing {
  id                String   @id @default(cuid())
  eventId           String
  sellerId          String
  quantity          Int // original number of tickets listed
  availableQuantity Int // tickets not currently reserved or sold
  priceCents        Int // fixed price per ticket
  notes             String? // revealed to a buyer after they reserve
  status            String   @default("OPEN") // OPEN | SOLD_OUT | CANCELLED
  postedAt          DateTime @default(now())
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seller User   @relation("ListingSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  deals  Deal[]

  @@index([eventId, status, priceCents, postedAt])
  @@index([sellerId])
}

// A buyer reservation against one seller listing. The chat opens immediately.
// Lifecycle: RESERVED → COMPLETED, or RESERVED → CANCELLED / EXPIRED.
model Deal {
  id        String @id @default(cuid())
  eventId   String
  listingId String
  buyerId   String
  sellerId  String

  quantity               Int
  unitPriceCents         Int // snapshot of the listing price when reserved
  status                 String    @default("RESERVED")
  reservationExpiresAt   DateTime
  expiringSoonNotifiedAt DateTime?
  buyerConfirmed         Boolean   @default(false)
  sellerConfirmed        Boolean   @default(false)
  completedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  listing       Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer         User           @relation("DealBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller        User           @relation("DealSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  ratings       Rating[]
  messages      Message[]
  notifications Notification[]

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([eventId, status])
  @@index([listingId, status])
  @@index([status, reservationExpiresAt]) // cron scan for stale reservations
}

// A message in the private chat attached to a Deal.
//
// RETENTION POLICY (trust & safety): chats are evidence. Accounts are
// soft-banned (User.bannedAt), never hard-deleted — do NOT add a hard
// `prisma.user.delete` flow, because `onDelete: Cascade` below would erase the
// counterparty's messages with them. If account erasure ever becomes a
// requirement (e.g. GDPR), change `sender` to `onDelete: SetNull` (making
// senderId nullable) and anonymize rather than delete, so the message bodies
// survive for moderation.
model Message {
  id        String   @id @default(cuid())
  dealId    String
  senderId  String
  body      String
  kind      String   @default("TEXT") // TEXT (a user message) | EVENT (a system lifecycle event)
  createdAt DateTime @default(now())

  deal   Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  sender User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([dealId, createdAt])
}

// An in-app notification for a user — "new message", "offer accepted", etc.
// Drives the nav unread badge and the notifications page.
model Notification {
  id        String    @id @default(cuid())
  userId    String //    recipient
  type      String // DEAL_STARTED | NEW_MESSAGE | TRADE_CONFIRMED | TRADE_COMPLETED | moderation/event notices
  dealId    String? // deep-link target (the deal desk), if any
  eventId   String? //   deep-link target for event lifecycle notifications
  body      String //    rendered, human-readable line
  readAt    DateTime? // set when the recipient has seen it
  createdAt DateTime  @default(now())

  user  User   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  deal  Deal?  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
}

// A reputation rating left after a completed trade.
model Rating {
  id        String   @id @default(cuid())
  dealId    String
  authorId  String // who left the rating
  subjectId String // who is being rated
  stars     Int //    1..5
  comment   String?
  createdAt DateTime @default(now())

  deal    Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  author  User @relation("RatingAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject User @relation("RatingSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  // One rating per author per deal.
  @@unique([dealId, authorId])
  @@index([subjectId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reportedId String
  listingId  String?
  reason     String
  details    String?
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reportedId])
}

// A pending admin invite for a campus email not yet registered. On first sign-in
// the auth callback promotes the new user to ADMIN and deletes this row.
model AdminInvite {
  id        String   @id @default(cuid())
  email     String   @unique
  createdBy String // superadmin user ID (no FK — avoids cascade complexity)
  createdAt DateTime @default(now())
}

// An ad unit managed by superadmins. Placement determines which page renders it.
model Ad {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String?
  linkUrl   String?
  body      String?
  placement String // "EVENTS_LIST" | "EVENT_PAGE"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, active])
}
