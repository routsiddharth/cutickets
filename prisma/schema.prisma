// Campus Ticket Board — data model
// Postgres in every environment (local + Vercel). Note: status/type fields are
// Strings validated in application code (see src/lib/constants.ts) rather than
// native enums, to keep migrations cheap.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Env vars auto-injected by the Vercel Postgres/Neon integration:
  url       = env("POSTGRES_PRISMA_URL") //      pooled (pgbouncer) — runtime
  directUrl = env("POSTGRES_URL_NON_POOLING") // direct — used for migrations
}

// ─── Auth.js (NextAuth) models ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // Campus Ticket Board profile fields (collected at onboarding)
  school    String? // e.g. "Columbia College", "Barnard College", "SEAS", "GS"
  classYear Int? //    graduation year, e.g. 2027
  bannedAt  DateTime? // set when an admin/automated control bans the account
  role      String    @default("USER") // "USER" | "ADMIN"

  // Phone verification (Firebase phone OTP, gated before profile setup)
  phone           String? //   E.164, e.g. "+15551234567"
  phoneVerifiedAt DateTime? // set once the OTP is confirmed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  listings         Listing[]
  matchesAsBuyer   Match[]        @relation("MatchBuyer")
  matchesAsSeller  Match[]        @relation("MatchSeller")
  reportsMade      Report[]       @relation("Reporter")
  reportsReceived  Report[]       @relation("Reported")
  ratingsGiven     Rating[]       @relation("RatingAuthor")
  ratingsReceived  Rating[]       @relation("RatingSubject")
  eventsCreated    Event[]        @relation("EventCreator")
  eventRequests    EventRequest[] @relation("EventRequester")
  requestsResolved EventRequest[] @relation("EventRequestResolver")
  messagesSent     Message[]      @relation("MessageSender")
  notifications    Notification[] @relation("UserNotifications")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Marketplace models ────────────────────────────────────────────────────

model Event {
  id          String    @id @default(cuid())
  name        String
  venue       String?
  startsAt    DateTime?
  description String?
  poshLink    String? // optional link to the event's Posh page
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  createdBy     User           @relation("EventCreator", fields: [createdById], references: [id])
  listings      Listing[]
  matches       Match[]
  requests      EventRequest[]
  notifications Notification[]

  @@index([startsAt])
  @@index([archivedAt, startsAt])
}

// A student suggestion for an event that is missing from the market. Admins
// can create an event from the request or dismiss it without exposing an event
// creation surface to regular users.
model EventRequest {
  id           String    @id @default(cuid())
  requesterId  String
  name         String
  venue        String?
  startsAt     DateTime?
  details      String?
  status       String    @default("PENDING") // PENDING | FULFILLED | DISMISSED
  eventId      String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  requester  User   @relation("EventRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  resolvedBy User?  @relation("EventRequestResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  event      Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([requesterId, status])
}

// A Listing is an *order* on an event's market: a SELL (ask = the least the
// lister will accept) or a BUY (bid = the most they'll pay), both per ticket.
// The matching engine (src/lib/matching.ts) auto-pairs crossing orders.
model Listing {
  id                String   @id @default(cuid())
  eventId           String
  userId            String
  type              String // "SELL" (ask) | "BUY" (bid)  (see constants)
  quantity          Int //    original total quantity submitted
  remainingQuantity Int //  qty still live on the book (not reserved, not filled)
  priceCents        Int //   limit price per ticket, in cents (ask = min accept, bid = max pay)
  notes             String? // revealed to the counterparty only AFTER a match — never on the book
  status            String   @default("OPEN") // OPEN | FILLED | CANCELLED (EXPIRED is computed from expiresAt)
  postedAt          DateTime @default(now()) // immutable FIFO tiebreaker for price-time priority
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  buyMatches     Match[]                @relation("BuyOrder")
  sellMatches    Match[]                @relation("SellOrder")
  buyExclusions  ReservationExclusion[] @relation("BuyExclusion")
  sellExclusions ReservationExclusion[] @relation("SellExclusion")

  // Hot path: candidate selection in the matching engine.
  @@index([eventId, type, status, priceCents, postedAt])
  @@index([userId])
}

// A Match is an auto-generated *reservation* between a buy order and a sell
// order, created by the matching engine the instant their prices cross. It then
// becomes a trade once both parties accept and confirm the handoff.
//
// Lifecycle: RESERVED → ACCEPTED → COMPLETED, or → DECLINED / EXPIRED / CANCELLED.
//  • RESERVED  : engine reserved the tickets; both must accept within 24h.
//  • ACCEPTED  : both accepted → identities + notes revealed, chat opens.
//  • COMPLETED : both confirmed the in-person handoff (drives last-sale & reputation).
//  • DECLINED/EXPIRED : freed tickets re-enter the book and re-match the next in queue.
//
// Pricing: settlePriceCents = the *resting* (maker) order's limit price — the
// order that was already on the book when the incoming (taker) order crossed it.
model Match {
  id          String @id @default(cuid())
  eventId     String // denormalized for cheap per-event queries / last-sale lookups
  buyOrderId  String
  sellOrderId String
  buyerId     String // buyOrder.userId
  sellerId    String // sellOrder.userId

  reservedQuantity Int //  tickets locked by this reservation
  settlePriceCents Int //  the resting (maker) order's price — the trade price
  status           String @default("RESERVED")

  // Stage 1 — ACCEPT (RESERVED → ACCEPTED). Both must accept to open the chat.
  buyerAccepted          Boolean   @default(false)
  sellerAccepted         Boolean   @default(false)
  acceptedAt             DateTime?
  reservationExpiresAt   DateTime // now + 24h; the cron expires reservations past this
  expiringSoonNotifiedAt DateTime? // idempotency guard for the "expiring soon" nudge

  // Stage 2 — CONFIRM HANDOFF (ACCEPTED → COMPLETED). Both confirm independently.
  buyerConfirmed   Boolean   @default(false)
  sellerConfirmed  Boolean   @default(false)
  agreedPriceCents Int? //   = settlePriceCents, recorded on completion
  completedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  buyOrder      Listing        @relation("BuyOrder", fields: [buyOrderId], references: [id], onDelete: Cascade)
  sellOrder     Listing        @relation("SellOrder", fields: [sellOrderId], references: [id], onDelete: Cascade)
  buyer         User           @relation("MatchBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller        User           @relation("MatchSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  ratings       Rating[]
  messages      Message[]
  notifications Notification[]

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([eventId, status])
  @@index([status, reservationExpiresAt]) // cron scan for stale reservations
}

// Records a buy↔sell order pairing that just failed (declined or timed out), so
// the matching engine never immediately re-pairs the same two orders — the freed
// tickets roll to the *next* counterparty in the price-time queue.
model ReservationExclusion {
  id          String   @id @default(cuid())
  buyOrderId  String
  sellOrderId String
  reason      String // "DECLINED" | "EXPIRED" | "CANCELLED"
  createdAt   DateTime @default(now())

  buyOrder  Listing @relation("BuyExclusion", fields: [buyOrderId], references: [id], onDelete: Cascade)
  sellOrder Listing @relation("SellExclusion", fields: [sellOrderId], references: [id], onDelete: Cascade)

  @@unique([buyOrderId, sellOrderId])
  @@index([buyOrderId])
  @@index([sellOrderId])
}

// A message in the on-site chat between the two parties of a Match. The Match IS
// the conversation; a chat is "all Messages with this matchId, ordered by time."
// The chat opens once a match is ACCEPTED — identities are revealed on the deal
// desk, but the conversation stays on-platform so it survives as a dispute
// record.
//
// RETENTION POLICY (trust & safety): chats are evidence. Accounts are
// soft-banned (User.bannedAt), never hard-deleted — do NOT add a hard
// `prisma.user.delete` flow, because `onDelete: Cascade` below would erase the
// counterparty's messages with them. If account erasure ever becomes a
// requirement (e.g. GDPR), change `sender` to `onDelete: SetNull` (making
// senderId nullable) and anonymize rather than delete, so the message bodies
// survive for moderation.
model Message {
  id        String   @id @default(cuid())
  matchId   String
  senderId  String
  body      String
  kind      String   @default("TEXT") // TEXT (a user message) | EVENT (a system lifecycle event)
  createdAt DateTime @default(now())

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender User  @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
}

// An in-app notification for a user — "new message", "offer accepted", etc.
// Drives the nav unread badge and the notifications page.
model Notification {
  id        String    @id @default(cuid())
  userId    String //    recipient
  type      String //    MATCH_FOUND | OFFER_ACCEPTED | RESERVATION_EXPIRING | NEW_MESSAGE | TRADE_CONFIRMED | TRADE_COMPLETED
  matchId   String? //   deep-link target (the deal desk), if any
  eventId   String? //   deep-link target for event lifecycle notifications
  body      String //    rendered, human-readable line
  readAt    DateTime? // set when the recipient has seen it
  createdAt DateTime  @default(now())

  user  User   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  match Match? @relation(fields: [matchId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
}

// A reputation rating left after a completed trade.
model Rating {
  id        String   @id @default(cuid())
  matchId   String
  authorId  String // who left the rating
  subjectId String // who is being rated
  stars     Int //    1..5
  comment   String?
  createdAt DateTime @default(now())

  match   Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  author  User  @relation("RatingAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject User  @relation("RatingSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  // One rating per author per match.
  @@unique([matchId, authorId])
  @@index([subjectId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reportedId String
  listingId  String?
  reason     String
  details    String?
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reportedId])
}

// A pending admin invite for a campus email not yet registered. On first sign-in
// the auth callback promotes the new user to ADMIN and deletes this row.
model AdminInvite {
  id        String   @id @default(cuid())
  email     String   @unique
  createdBy String // superadmin user ID (no FK — avoids cascade complexity)
  createdAt DateTime @default(now())
}

// An ad unit managed by superadmins. Placement determines which page renders it.
model Ad {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String?
  linkUrl   String?
  body      String?
  placement String // "EVENTS_LIST" | "EVENT_PAGE"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, active])
}
