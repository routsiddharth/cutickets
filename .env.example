# ─── Database (Neon Postgres) ─────────────────────────────────────────────
# DATABASE_URL = pooled connection string (host contains "-pooler"). Used at
# runtime by serverless functions.
# DIRECT_URL   = direct (non-pooled) connection string. Used for migrations.
# Get both from the Neon dashboard → Connection Details.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/cutickets?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/cutickets?sslmode=require"

# ─── Auth.js / NextAuth ───────────────────────────────────────────────────
# Generate a secret with:  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Google OAuth credentials.
# Create at https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI (dev): http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Access control ───────────────────────────────────────────────────────
# Comma-separated list of email domains allowed to sign in.
ALLOWED_EMAIL_DOMAINS="columbia.edu,barnard.edu"

# ─── Local dev convenience (NEVER enable in production) ────────────────────
# When "true" AND NODE_ENV !== "production", exposes a password-less
# "dev login" so you can test the full app without real Google credentials.
# It only ever issues accounts on the allowed domains above.
ALLOW_DEV_LOGIN="true"
