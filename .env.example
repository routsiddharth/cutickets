# ─── Database (Postgres) ──────────────────────────────────────────────────
# On Vercel these two are injected automatically by the Postgres/Neon
# integration — you don't set them by hand.
#   POSTGRES_PRISMA_URL      = pooled connection (pgbouncer) — runtime
#   POSTGRES_URL_NON_POOLING = direct connection — migrations
# For LOCAL dev, point both at your local/remote Postgres (same value is fine):
POSTGRES_PRISMA_URL="postgresql://user:password@localhost:5432/cutickets?schema=public"
POSTGRES_URL_NON_POOLING="postgresql://user:password@localhost:5432/cutickets?schema=public"

# ─── Auth.js / NextAuth ───────────────────────────────────────────────────
# Generate a secret with:  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Google OAuth credentials.
# Create at https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI (dev): http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Background jobs (Vercel Cron) ────────────────────────────────────────
# Secret that guards /api/cron/reservations. Vercel Cron automatically sends it
# as "Authorization: Bearer $CRON_SECRET". Generate with: openssl rand -hex 32
CRON_SECRET=""

# ─── Access control ───────────────────────────────────────────────────────
# Comma-separated list of email domains allowed to sign in.
ALLOWED_EMAIL_DOMAINS="columbia.edu,barnard.edu"

# ─── Local dev convenience (NEVER enable in production) ────────────────────
# When "true" AND NODE_ENV !== "production", exposes a password-less
# "dev login" so you can test the full app without real Google credentials.
# It only ever issues accounts on the allowed domains above.
ALLOW_DEV_LOGIN="true"
